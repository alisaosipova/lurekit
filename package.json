{
  "name": "lurekit",
  "version": "1.7.0",
  "description": "LureKit: a runnable, disclosure-traced security benchmark for deployed coding-agent configurations.",
  "keywords": [
    "security-benchmark",
    "coding-agents",
    "prompt-injection",
    "mcp",
    "claude-code",
    "agent-security",
    "supply-chain",
    "canary"
  ],
  "homepage": "https://github.com/alisaosipova/lurekit#readme",
  "bugs": {
    "url": "https://github.com/alisaosipova/lurekit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alisaosipova/lurekit.git"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "schemas",
    "scenarios",
    "demo",
    "profiles",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "lurekit": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "report": "node dist/tools/report.js",
    "validate:scenarios": "node dist/tools/validate-scenarios.js scenarios",
    "catalog": "node scripts/catalog.mjs",
    "matrix": "node scripts/matrix.mjs",
    "assets:demo": "node scripts/render-demo-svg.mjs",
    "docs:numbers": "node scripts/numbers.mjs",
    "changelog:check": "node scripts/changelog-frozen.mjs",
    "docs:check": "npm run build && node scripts/numbers.mjs --check && node scripts/catalog.mjs --check && node scripts/matrix.mjs --check && node scripts/render-demo-svg.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "~5.9",
    "vitest": "^4.1.12"
  }
}
