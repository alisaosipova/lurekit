{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alisaosipova/agent-attack-bench/schemas/manifest.schema.json",
  "title": "agent-attack-bench run manifest",
  "description": "Per-benchmark-run manifest (evidence-spec §2.3). One per benchmark run, written as manifest.json.",
  "type": "object",
  "required": [
    "manifest_schema",
    "benchmark_run_id",
    "created_at",
    "tool_version",
    "mode",
    "config",
    "corpus",
    "profile",
    "results",
    "totals"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_schema": { "const": "0.1" },
    "benchmark_run_id": { "type": "string" },
    "created_at": { "type": "string" },
    "tool_version": { "type": "string" },
    "mode": { "enum": ["smoke", "full"] },
    "config": {
      "type": "object",
      "required": ["k", "vulnerable_if", "isolation", "budget_usd"],
      "additionalProperties": false,
      "properties": {
        "k": { "type": "integer", "minimum": 1 },
        "vulnerable_if": { "enum": ["any", "majority"] },
        "isolation": { "type": "string" },
        "budget_usd": { "type": ["number", "null"] }
      }
    },
    "corpus": {
      "type": "object",
      "required": ["scenario_count", "scenario_ids", "corpus_digest"],
      "additionalProperties": false,
      "properties": {
        "scenario_count": { "type": "integer", "minimum": 0 },
        "scenario_ids": { "type": "array", "items": { "type": "string" } },
        "corpus_digest": { "type": "string" }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "agent",
        "agent_version",
        "model",
        "permission_mode",
        "used_bare",
        "mcp",
        "hooks",
        "skills",
        "settings_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string" },
        "agent_version": { "type": "string" },
        "model": { "type": "string" },
        "permission_mode": { "type": ["string", "null"] },
        "used_bare": { "type": "boolean" },
        "mcp": { "type": "string" },
        "strict_mcp_config": { "type": "boolean" },
        "hooks": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "settings_digest": { "type": "string" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "name", "source", "detector", "verdict", "confidence", "runs", "spend_usd"],
        "additionalProperties": false,
        "properties": {
          "scenario_id": { "type": "string" },
          "name": { "type": "string" },
          "source": { "type": "string" },
          "detector": {
            "enum": [
              "canary_egress_http",
              "canary_egress_dns",
              "canary_file_read",
              "canary_command",
              "canary_mcp_tool",
              "fs_diff"
            ]
          },
          "verdict": { "enum": ["resisted", "vulnerable", "degraded", "inconclusive"] },
          "confidence": { "type": "string" },
          "runs": { "type": "integer", "minimum": 0 },
          "spend_usd": { "type": "number" },
          "isolation": { "enum": ["full", "partial", "unreported"], "description": "MCP isolation in effect (evidence-spec §4.3): partial = --strict-mcp-config not in effect (declared requirement or operator opt-out); unreported = adapter did not report its argv." },
          "strict_mcp_config": { "type": "boolean", "description": "Whether --strict-mcp-config was in effect for every repetition of this scenario, from the argv each adapter reported (evidence-spec §2.3, §4.3): what ran. profile.strict_mcp_config is the operator policy. false if any repetition ran without the flag; absent when not attestable (no repetition reached the adapter, or one reported no argv)." },
          "resisted_kind": { "enum": ["not_attempted", "denied"], "description": "Why a resisted verdict resisted (evidence-spec §3.1): not_attempted = no recorded attempt targeted the forbidden effect; denied = the agent issued a tool use the detector would have counted but the setup blocked it (permission gate or tool error, §4.2). Present only when the verdict/outcome is resisted." }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["resisted", "vulnerable", "degraded", "inconclusive", "spend_usd"],
      "additionalProperties": false,
      "properties": {
        "resisted": { "type": "integer", "minimum": 0 },
        "vulnerable": { "type": "integer", "minimum": 0 },
        "degraded": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "spend_usd": { "type": "number" }
      }
    }
  }
}
